#!/usr/bin/env bash
# dlc — AI-DLC Skills CLI
# Single command to install, update, list, and manage AI-DLC skills
#
# Usage:
#   dlc install          Install all skills to ~/.claude/
#   dlc update           Update skills from repo (pull + install)
#   dlc list             List installed skills and commands
#   dlc doctor           Run /heal-skill all equivalent checks
#   dlc export [format]  Export skills in different formats
#   dlc version          Show version

set -euo pipefail

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
CLAUDE_DIR="${HOME}/.claude"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
  echo "dlc — AI-DLC Skills CLI v${VERSION}"
  echo ""
  echo "Usage: dlc <command>"
  echo ""
  echo "Commands:"
  echo "  install       Install all skills and commands to ~/.claude/"
  echo "  update        Pull latest changes and re-install"
  echo "  list          List installed skills and commands"
  echo "  doctor        Validate all skills (structure, references, sync)"
  echo "  export <fmt>  Export skills (formats: markdown, json, yaml)"
  echo "  diff          Show differences between repo and installed versions"
  echo "  uninstall     Remove AI-DLC skills from ~/.claude/"
  echo "  version       Show version"
  echo ""
  echo "Quick start:"
  echo "  git clone https://github.com/msifoss/ai-dlc.git"
  echo "  cd ai-dlc && bash scripts/dlc install"
  echo ""
  echo "Or install directly:"
  echo "  curl -fsSL https://raw.githubusercontent.com/msifoss/ai-dlc/main/scripts/dlc | bash -s install"
}

cmd_install() {
  echo -e "${BLUE}Installing AI-DLC skills ecosystem v${VERSION}...${NC}"
  echo "  Source: ${REPO_DIR}/skills/"
  echo "  Target: ${CLAUDE_DIR}/"
  echo ""

  # Create target directories
  mkdir -p "${CLAUDE_DIR}/commands"
  mkdir -p "${CLAUDE_DIR}/skills"

  # Install commands
  local cmd_count=0
  if [ -d "${REPO_DIR}/skills/commands" ]; then
    for cmd in "${REPO_DIR}/skills/commands"/*.md; do
      [ -f "$cmd" ] || continue
      local name
      name=$(basename "$cmd")
      cp "$cmd" "${CLAUDE_DIR}/commands/${name}"
      cmd_count=$((cmd_count + 1))
    done
  fi
  echo -e "  ${GREEN}✓${NC} ${cmd_count} commands installed"

  # Install skills
  local skill_count=0
  if [ -d "${REPO_DIR}/skills/skills" ]; then
    for skill_dir in "${REPO_DIR}/skills/skills"/*/; do
      [ -d "$skill_dir" ] || continue
      local name
      name=$(basename "$skill_dir")
      mkdir -p "${CLAUDE_DIR}/skills/${name}"
      cp -r "${skill_dir}"* "${CLAUDE_DIR}/skills/${name}/"
      skill_count=$((skill_count + 1))
    done
  fi
  echo -e "  ${GREEN}✓${NC} ${skill_count} skills installed"
  echo ""
  echo -e "${GREEN}Done.${NC} Skills are available immediately in Claude Code."
}

cmd_update() {
  echo -e "${BLUE}Updating AI-DLC skills...${NC}"

  # Pull latest if in a git repo
  if [ -d "${REPO_DIR}/.git" ]; then
    echo "  Pulling latest changes..."
    git -C "${REPO_DIR}" pull --rebase 2>/dev/null || {
      echo -e "  ${YELLOW}Warning: git pull failed (working directory dirty?)${NC}"
      echo "  Installing from current state..."
    }
  fi

  cmd_install
}

cmd_list() {
  echo -e "${BLUE}AI-DLC Skills Inventory${NC}"
  echo ""

  # List commands
  echo "Commands (slash commands):"
  if [ -d "${CLAUDE_DIR}/commands" ]; then
    for cmd in "${CLAUDE_DIR}/commands"/*.md; do
      [ -f "$cmd" ] || continue
      local name
      name=$(basename "$cmd" .md)
      local title
      title=$(head -1 "$cmd" | sed 's/^# \///' | sed 's/ — /\t/')
      echo -e "  ${GREEN}/${name}${NC}\t${title}"
    done
  else
    echo "  (none installed)"
  fi

  echo ""
  echo "Skills (full agent-based):"
  if [ -d "${CLAUDE_DIR}/skills" ]; then
    for skill_dir in "${CLAUDE_DIR}/skills"/*/; do
      [ -d "$skill_dir" ] || continue
      local name
      name=$(basename "$skill_dir")
      if [ -f "${skill_dir}SKILL.md" ]; then
        local title
        title=$(head -1 "${skill_dir}SKILL.md" | sed 's/^# \///' | sed 's/ — /\t/')
        echo -e "  ${GREEN}/${name}${NC}\t${title}"
      else
        echo -e "  ${YELLOW}/${name}${NC}\t(no SKILL.md)"
      fi
    done
  else
    echo "  (none installed)"
  fi
}

cmd_doctor() {
  echo -e "${BLUE}Running AI-DLC skills health check...${NC}"
  echo ""

  local issues=0
  local checked=0

  # Check commands
  for cmd in "${REPO_DIR}/skills/commands"/*.md; do
    [ -f "$cmd" ] || continue
    local name
    name=$(basename "$cmd")
    checked=$((checked + 1))

    # Check installed
    if [ ! -f "${CLAUDE_DIR}/commands/${name}" ]; then
      echo -e "  ${RED}✗${NC} /${name%.md}: not installed"
      issues=$((issues + 1))
      continue
    fi

    # Check sync
    if ! diff -q "$cmd" "${CLAUDE_DIR}/commands/${name}" >/dev/null 2>&1; then
      echo -e "  ${YELLOW}~${NC} /${name%.md}: out of sync (repo differs from installed)"
      issues=$((issues + 1))
      continue
    fi

    # Check structure
    if ! grep -q "## Purpose" "$cmd" 2>/dev/null; then
      echo -e "  ${YELLOW}~${NC} /${name%.md}: missing Purpose section"
      issues=$((issues + 1))
      continue
    fi

    echo -e "  ${GREEN}✓${NC} /${name%.md}"
  done

  # Check skills
  for skill_dir in "${REPO_DIR}/skills/skills"/*/; do
    [ -d "$skill_dir" ] || continue
    local name
    name=$(basename "$skill_dir")
    checked=$((checked + 1))

    if [ ! -f "${CLAUDE_DIR}/skills/${name}/SKILL.md" ]; then
      echo -e "  ${RED}✗${NC} /${name}: not installed"
      issues=$((issues + 1))
      continue
    fi

    if [ ! -f "${skill_dir}SKILL.md" ]; then
      echo -e "  ${RED}✗${NC} /${name}: missing SKILL.md in repo"
      issues=$((issues + 1))
      continue
    fi

    if ! diff -q "${skill_dir}SKILL.md" "${CLAUDE_DIR}/skills/${name}/SKILL.md" >/dev/null 2>&1; then
      echo -e "  ${YELLOW}~${NC} /${name}: out of sync"
      issues=$((issues + 1))
      continue
    fi

    echo -e "  ${GREEN}✓${NC} /${name}"
  done

  echo ""
  echo -e "Checked: ${checked} | Issues: ${issues}"

  if [ "$issues" -gt 0 ]; then
    echo -e "${YELLOW}Run 'dlc install' to fix sync issues.${NC}"
    return 1
  else
    echo -e "${GREEN}All skills healthy.${NC}"
  fi
}

cmd_export() {
  local format="${1:-markdown}"
  echo -e "${BLUE}Exporting skills as ${format}...${NC}"

  case "$format" in
    markdown|md)
      local outfile="${REPO_DIR}/SKILLS-EXPORT.md"
      echo "# AI-DLC Skills Export" > "$outfile"
      echo "" >> "$outfile"
      echo "Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$outfile"
      echo "" >> "$outfile"

      echo "## Commands" >> "$outfile"
      echo "" >> "$outfile"
      for cmd in "${REPO_DIR}/skills/commands"/*.md; do
        [ -f "$cmd" ] || continue
        echo "---" >> "$outfile"
        echo "" >> "$outfile"
        cat "$cmd" >> "$outfile"
        echo "" >> "$outfile"
      done

      echo "## Skills" >> "$outfile"
      echo "" >> "$outfile"
      for skill_dir in "${REPO_DIR}/skills/skills"/*/; do
        [ -d "$skill_dir" ] || continue
        if [ -f "${skill_dir}SKILL.md" ]; then
          echo "---" >> "$outfile"
          echo "" >> "$outfile"
          cat "${skill_dir}SKILL.md" >> "$outfile"
          echo "" >> "$outfile"
        fi
      done

      echo -e "${GREEN}Exported to ${outfile}${NC}"
      ;;

    json)
      local outfile="${REPO_DIR}/skills-export.json"
      echo "{" > "$outfile"
      echo '  "version": "'"${VERSION}"'",' >> "$outfile"
      echo '  "exported": "'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'",' >> "$outfile"
      echo '  "commands": [' >> "$outfile"

      local first=true
      for cmd in "${REPO_DIR}/skills/commands"/*.md; do
        [ -f "$cmd" ] || continue
        local name
        name=$(basename "$cmd" .md)
        local title
        title=$(head -1 "$cmd" | sed 's/^# \/[^ ]* — //')
        if [ "$first" = true ]; then first=false; else echo "," >> "$outfile"; fi
        printf '    {"name": "%s", "title": "%s", "file": "skills/commands/%s.md"}' "$name" "$title" "$name" >> "$outfile"
      done

      echo "" >> "$outfile"
      echo '  ],' >> "$outfile"
      echo '  "skills": [' >> "$outfile"

      first=true
      for skill_dir in "${REPO_DIR}/skills/skills"/*/; do
        [ -d "$skill_dir" ] || continue
        local name
        name=$(basename "$skill_dir")
        if [ -f "${skill_dir}SKILL.md" ]; then
          local title
          title=$(head -1 "${skill_dir}SKILL.md" | sed 's/^# \/[^ ]* — //' | sed 's/^---$//')
          if [ "$first" = true ]; then first=false; else echo "," >> "$outfile"; fi
          printf '    {"name": "%s", "title": "%s", "file": "skills/skills/%s/SKILL.md"}' "$name" "$title" "$name" >> "$outfile"
        fi
      done

      echo "" >> "$outfile"
      echo '  ]' >> "$outfile"
      echo "}" >> "$outfile"

      echo -e "${GREEN}Exported to ${outfile}${NC}"
      ;;

    yaml|yml)
      local outfile="${REPO_DIR}/skills-export.yaml"
      echo "# AI-DLC Skills Export" > "$outfile"
      echo "version: \"${VERSION}\"" >> "$outfile"
      echo "exported: \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"" >> "$outfile"
      echo "" >> "$outfile"
      echo "commands:" >> "$outfile"

      for cmd in "${REPO_DIR}/skills/commands"/*.md; do
        [ -f "$cmd" ] || continue
        local name
        name=$(basename "$cmd" .md)
        local title
        title=$(head -1 "$cmd" | sed 's/^# \/[^ ]* — //')
        echo "  - name: \"${name}\"" >> "$outfile"
        echo "    title: \"${title}\"" >> "$outfile"
        echo "    file: \"skills/commands/${name}.md\"" >> "$outfile"
      done

      echo "" >> "$outfile"
      echo "skills:" >> "$outfile"

      for skill_dir in "${REPO_DIR}/skills/skills"/*/; do
        [ -d "$skill_dir" ] || continue
        local name
        name=$(basename "$skill_dir")
        if [ -f "${skill_dir}SKILL.md" ]; then
          local title
          title=$(head -1 "${skill_dir}SKILL.md" | sed 's/^# \/[^ ]* — //' | sed 's/^---$//')
          echo "  - name: \"${name}\"" >> "$outfile"
          echo "    title: \"${title}\"" >> "$outfile"
          echo "    file: \"skills/skills/${name}/SKILL.md\"" >> "$outfile"
        fi
      done

      echo -e "${GREEN}Exported to ${outfile}${NC}"
      ;;

    *)
      echo -e "${RED}Unknown format: ${format}${NC}"
      echo "Supported: markdown, json, yaml"
      return 1
      ;;
  esac
}

cmd_diff() {
  echo -e "${BLUE}Comparing repo vs installed skills...${NC}"
  echo ""

  local diffs=0

  for cmd in "${REPO_DIR}/skills/commands"/*.md; do
    [ -f "$cmd" ] || continue
    local name
    name=$(basename "$cmd")
    if [ -f "${CLAUDE_DIR}/commands/${name}" ]; then
      if ! diff -q "$cmd" "${CLAUDE_DIR}/commands/${name}" >/dev/null 2>&1; then
        echo -e "${YELLOW}Modified:${NC} commands/${name}"
        diff --color=auto "$cmd" "${CLAUDE_DIR}/commands/${name}" || true
        echo ""
        diffs=$((diffs + 1))
      fi
    else
      echo -e "${RED}Not installed:${NC} commands/${name}"
      diffs=$((diffs + 1))
    fi
  done

  for skill_dir in "${REPO_DIR}/skills/skills"/*/; do
    [ -d "$skill_dir" ] || continue
    local name
    name=$(basename "$skill_dir")
    if [ -f "${CLAUDE_DIR}/skills/${name}/SKILL.md" ] && [ -f "${skill_dir}SKILL.md" ]; then
      if ! diff -q "${skill_dir}SKILL.md" "${CLAUDE_DIR}/skills/${name}/SKILL.md" >/dev/null 2>&1; then
        echo -e "${YELLOW}Modified:${NC} skills/${name}/SKILL.md"
        diff --color=auto "${skill_dir}SKILL.md" "${CLAUDE_DIR}/skills/${name}/SKILL.md" || true
        echo ""
        diffs=$((diffs + 1))
      fi
    fi
  done

  if [ "$diffs" -eq 0 ]; then
    echo -e "${GREEN}All skills in sync.${NC}"
  else
    echo -e "${YELLOW}${diffs} difference(s) found. Run 'dlc install' to sync.${NC}"
  fi
}

cmd_uninstall() {
  echo -e "${RED}Removing AI-DLC skills...${NC}"
  echo ""

  # Only remove skills that exist in the repo (don't nuke user's other skills)
  local removed=0
  for cmd in "${REPO_DIR}/skills/commands"/*.md; do
    [ -f "$cmd" ] || continue
    local name
    name=$(basename "$cmd")
    if [ -f "${CLAUDE_DIR}/commands/${name}" ]; then
      rm "${CLAUDE_DIR}/commands/${name}"
      removed=$((removed + 1))
    fi
  done

  for skill_dir in "${REPO_DIR}/skills/skills"/*/; do
    [ -d "$skill_dir" ] || continue
    local name
    name=$(basename "$skill_dir")
    if [ -d "${CLAUDE_DIR}/skills/${name}" ]; then
      rm -rf "${CLAUDE_DIR}/skills/${name}"
      removed=$((removed + 1))
    fi
  done

  echo -e "${GREEN}Removed ${removed} skills/commands.${NC}"
}

# Main dispatch
case "${1:-}" in
  install)  cmd_install ;;
  update)   cmd_update ;;
  list)     cmd_list ;;
  doctor)   cmd_doctor ;;
  export)   cmd_export "${2:-markdown}" ;;
  diff)     cmd_diff ;;
  uninstall) cmd_uninstall ;;
  version)  echo "dlc v${VERSION}" ;;
  -h|--help|help|"") usage ;;
  *)
    echo -e "${RED}Unknown command: $1${NC}"
    echo ""
    usage
    exit 1
    ;;
esac
